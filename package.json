{
  "name": "bookmark-home",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "基于 Chrome 原生书签的双向同步新标签页",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:extension": "node scripts/verify-extension.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm zip && pnpm verify:extension",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "@wxt-dev/module-vue": "^1.0.3",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "fflate": "^0.8.3",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14",
    "wxt": "^0.21.5"
  }
}
